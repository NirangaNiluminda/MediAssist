# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real keys.

# OpenAI API (used by prompt_templates.py)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Local Ollama model name (fallback when no OpenAI key)
# Run: ollama pull llama3
OLLAMA_MODEL=llama3

# Hugging Face token (needed for gated models, optional)
# Run: huggingface-cli login  OR set here
HF_TOKEN=hf_...
